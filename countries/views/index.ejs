<% layout('./layout/page.ejs') %>

  <h2>Список стран</h2>

  <p>Выберите страну, чтобы посмотреть информацию:</p>

  <ul>
    <% countries.forEach(function(country) { %>

      <li>
        <a href="/<%= country.slug %>">
          <%= country.name %>
        </a>
      </li>

      <% }); %>
  </ul>