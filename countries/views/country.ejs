<% layout('./layout/page.ejs') %>

    <div class="country-card">

        <div class="country-photo">
            <img src="/images/<%= country.slug %>.jpg" alt="<%= country.name %>">
        </div>

        <div class="country-title">
            <span>✿ СТРАНА МИРА ✿</span>
            <h2>
                <%= country.name %>
            </h2>
            <p>
                <%= country.region %>
            </p>
        </div>

        <div class="country-details">

            <h3>Информация о стране</h3>

            <div class="country-grid">

                <div class="country-item">
                    <span>🌍</span>
                    <small>Континент</small>
                    <strong>
                        <%= country.region %>
                    </strong>
                </div>

                <div class="country-item">
                    <span>🏛️</span>
                    <small>Столица</small>
                    <strong>
                        <%= country.capital %>
                    </strong>
                </div>

                <div class="country-item">
                    <span>👥</span>
                    <small>Население</small>
                    <strong>
                        <%= country.population.toLocaleString('ru-RU') %>
                    </strong>
                </div>

                <div class="country-item">
                    <span>💬</span>
                    <small>Языки</small>
                    <strong>
                        <%= country.languages.join(', ') %></strong>
            </div>

        </div>

        <div class="country-section">
            <h3>🏙️ Крупные города</h3>

            <div class="country-cities">
                <% country.cities.forEach(function(city) { %>
                    <span><%= city %></span>
                <% }); %>
            </div>
        </div>

        <div class="country-section">
            <h3> Статус вакцинации</h3>

            <% if (country.vaccinated === true) { %>
                <span class="vaccine yes">✓ Вакцинация: да</span>
            <% } else if (country.vaccinated === false) { %>
                <span class="vaccine no">Вакцинация: нет</span>
            <% } else { %>
                <span class="vaccine unknown">Не указано</span>
            <% } %>
        </div>

    </div>

    <a href="/" class="country-back">← Все страны</a>

</div>