<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">

    <title>
        <%= country.name %>
    </title>

    <link rel="stylesheet" href="/stylesheets/style.css" />
</head>

<body>

    <h1>
        <%= country.name %>
    </h1>

    <h2>Информация о стране</h2>

    <p>
        <b>Регион:</b>
        <%= country.region %>
    </p>

    <p>
        <b>Население:</b>
        <%= country.population %>
    </p>

    <p>
        <b>Столица:</b>
        <%= country.capital %>
    </p>

    <p>
        <b>Языки:</b>
        <%= country.languages.join(', ') %>
    </p>

    <p>
        <b>Крупные города:</b>
        <%= country.cities.join(' , ') %>
    </p>

    <p>
        <b>Вакцинация:</b>
        <%= country.vaccinated === undefined
            ? ' Не указано' : country.vaccinated ? 'Да' : 'Нет' %>
    </p>

</body>

</html>