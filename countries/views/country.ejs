<% layout('./layout/page.ejs') %>

    <h2>
        <%= country.name %>
    </h2>

    <h3>Информация о стране</h3>

    <p>
        <b>Регион:</b>
        <%= country.region %>
    </p>

    <p>
        <b>Население:</b>
        <%= country.population %>
    </p>

    <p>
        <b>Столица:</b>
        <%= country.capital %>
    </p>

    <p>
        <b>Языки:</b>
        <%= country.languages.join(', ') %>
</p>

<p>
    <b>Города:</b>
    <%= country.cities.join(' , ') %>
</p>

<p>
    <b>Вакцинация:</b>
    <%= country.vaccinated === undefined
        ? ' Не указано' : country.vaccinated ? 'Да' : 'Нет' %>
    </p>